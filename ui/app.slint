import { Theme } from "Theme.slint";
import { LogsScreen } from "screens/Logs.slint";
import { HomeScreen } from "screens/Home.slint";
import { SettingsScreen } from "screens/Settings.slint";

export component AppWindow inherits Window {
  title: "Netherfall Launcher";
  width: 900px; height: 580px;

  in-out property <string> page: "home";
  in-out property <float>  progress: 0.0;
  in-out property <[string]> logs: [];


  private property <length> pad: 16px;
  private property <length> sidebar_w: 200px;
  in-out property <string> settings_username: "Player";
  in-out property <int>    settings_ram_mb: 4096;
  in-out property <bool>   settings_compat_mode: false;
  in-out property <string> settings_java_path: "/usr/local/bin/java";
  in-out property <string> settings_game_dir: "~/.netherfall";

  callback open_game_dir();
  callback browse_game_dir();
  callback browse_java_path();
  callback save_settings();

  callback play();
  callback repair();


  Rectangle {
    background: Theme.bg;
    
    Rectangle {
      x: root.pad; y: root.pad;
      width: root.width - root.sidebar_w - 3*root.pad;
      height: root.height - 2*root.pad;
      border-radius: Theme.radius;
      background: Theme.surface;
      step := Timer {
        interval: 50ms; running: false;
        triggered => {
          root.progress = min(1.0, root.progress + 0.02);
          if (root.progress < 1.0) {
            step.running = true;  
          }
        }
      }

callback start_play();
start_play => {
  root.progress = 0.0;
  step.running = true;       
}

      VerticalLayout {
        x: 12px; y: 12px; width: parent.width - 24px; height: parent.height - 24px;
        spacing: 8px;

        Text { text: "Навигация"; color: Theme.textMuted; }

        // Главная
        Rectangle {
          width: parent.width; height: 40px; border-radius: 8px;
          background: root.page == "home" ? Theme.primary : Theme.surfaceAlt;
          animate background { duration: 160ms; easing: ease-in-out; }

          Text { x: 12px; y: 0px; width: parent.width; height: parent.height;
                 color: Theme.text; text: "Главная"; vertical-alignment: center; }
          TouchArea { x:0px; y:0px; width: parent.width; height: parent.height;
            clicked => { root.page = "home"; }
          }
        }

        // Настройки
        Rectangle {
          width: parent.width; height: 40px; border-radius: 8px;
          background: root.page == "settings" ? Theme.primary : Theme.surfaceAlt;
          animate background { duration: 160ms; easing: ease-in-out; }

          Text { x: 12px; y: 0px; width: parent.width; height: parent.height;
                 color: Theme.text; text: "Настройки"; vertical-alignment: center; }
          TouchArea { x:0px; y:0px; width: parent.width; height: parent.height;
            clicked => { root.page = "settings"; }
          }
        }
        Rectangle {
          width: parent.width; height: 44px;
          background: root.page == "logs" ? Theme.primary : Theme.surfaceAlt;
          border-radius: Theme.radius;

          Text {
            x: 12px; y: 0px; height: parent.height;
            vertical-alignment: center; color: Theme.text;
            text: "Логи";
          }

          TouchArea {
            x: 0px; y: 0px; width: parent.width; height: parent.height;
            clicked => { root.page = "logs"; }
          }
       } 
      }
    }

    Rectangle {
      x: root.pad + root.sidebar_w + root.pad;
      y: root.pad;
      width: root.width - root.sidebar_w - 3*root.pad;
      height: root.height - 2*root.pad;
      border-radius: Theme.radius;
      background: Theme.surface;
    

      // Главная
      HomeScreen {
        x: 16px; y: 16px; width: parent.width - 32px; height: parent.height - 32px;
        visible: root.page == "home";
        opacity: root.page == "home" ? 1.0 : 0.0;
        animate opacity { duration: 220ms; easing: ease-in-out; }
         play_clicked => { root.play(); }
         fix_clicked  => { root.repair(); }
      }

      // Логи
      LogsScreen {
        x: 16px; y: 16px; width: parent.width - 32px; height: parent.height - 32px;
        visible: root.page == "logs";
        opacity: root.page == "logs" ? 1.0 : 0.0;
        items <=> root.logs;   
        animate opacity { duration: 220ms; easing: ease-in-out; }
      }

      // Настройки
      SettingsScreen {
        x: 16px; y: 16px; width: parent.width - 32px; height: parent.height - 32px;
        visible: root.page == "settings";
        opacity: root.page == "settings" ? 1.0 : 0.0;
  

        username   <=> root.settings_username;
        ram_mb     <=> root.settings_ram_mb;
        compat_mode <=> root.settings_compat_mode;
        java_path  <=> root.settings_java_path;
        game_dir   <=> root.settings_game_dir;

        open_game_dir   => { root.open_game_dir(); }
        browse_game_dir => { root.browse_game_dir(); }
        browse_java_path => { root.browse_java_path(); }
        save_clicked    => { root.save_settings(); }
        
        

        animate opacity { duration: 220ms; easing: ease-in-out; }
      }
}

       

      kick := Timer {
        interval: 1ms; running: false;
        triggered => { root.progress = 1.0; }
      }

      callback start_play();
      start_play => {
        root.progress = 0.0;
        kick.running = true; 
      }
    }
  }

