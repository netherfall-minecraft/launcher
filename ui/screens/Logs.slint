import { Theme } from "../Theme.slint";

export component LogsScreen inherits Rectangle {
  in-out property <[string]> items;

  background: Theme.surface;

  VerticalLayout {
    padding: 16px; spacing: 8px;

    Text { text: "Логи"; color: Theme.text; font-size: 18px; }

    Rectangle {
      width: parent.width;
      height: parent.height - 32px;
      clip: true; 

      col := VerticalLayout {
        width: parent.width;
        spacing: 4px;

        for line in root.items : Text {
          width: parent.width;
          wrap: word-wrap;
          color: Theme.text;
          text: line;
        }
      }
    }
  }
}
